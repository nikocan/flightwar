{
  "name": "sky-force-evolution",
  "private": true,
  "version": "0.4.0",
  "description": "SKY FORCE EVOLUTION \u2014 futuristic 3D arcade aircraft combat game (monorepo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sfe/client",
    "build": "npm run build -w @sfe/client",
    "preview": "npm run preview -w @sfe/client",
    "typecheck": "npm run typecheck -w @sfe/shared && npm run typecheck -w @sfe/client",
    "test": "npm run test -w @sfe/shared",
    "test:e2e": "npm run test:e2e -w @sfe/client",
    "art:check": "node --experimental-strip-types --no-warnings scripts/check-art.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
